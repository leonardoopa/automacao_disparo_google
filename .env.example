# Copie para .env e preencha. O .env não vai para o git.

# Ponto central da busca (geocodificado pelo OpenStreetMap)
ORIGIN_ADDRESS=Rua Exemplo 1, Cidade
# Termos buscados no Maps, separados por vírgula
KEYWORDS=supermercado,mercado,tienda de alimentación
JOB_MAX_SECONDS=600

# Como enviar: "cloud" (API oficial da Meta, templates aprovados) ou "evolution" (Evolution API, QR no app, não oficial)
WHATSAPP_PROVIDER=cloud
# Teto de mensagens 1 por dia (UTC). Vazio = 0 (sem teto) na cloud e 30 na evolution.
# DAILY_SEND_LIMIT=30

# Evolution API (só com WHATSAPP_PROVIDER=evolution). Instância já conectada por QR no app do número remetente.
# Se a Evolution roda no seu Mac fora do compose, use http://host.docker.internal:8080
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# Segredo da URL do webhook: .../webhook/evolution?token=<este valor>
EVOLUTION_WEBHOOK_TOKEN=
# Evolution local pelo compose (--profile evolution): use EVOLUTION_URL=http://evolution-api:8080, uma EVOLUTION_API_KEY
# forte (openssl rand -hex 24) e uma senha para o Postgres dela:
EVOLUTION_DB_PASSWORD=

# WhatsApp Cloud API (Meta). Só preencha depois de ter número e template aprovados.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=troque-por-um-segredo
WHATSAPP_API_VERSION=v21.0
# PHONE_NUMBER_ID é o ID que a Meta dá ao número remetente (+34 688 64 69 95), não o número em si.
# O número precisa estar registrado na WhatsApp Business Platform (Cloud API).
SEND_DELAY_S=1.5
# PDF da mensagem 2 (dentro do container; a pasta ./assets é montada em /srv/assets)
WHATSAPP_PDF_PATH=/srv/assets/euno_supermercados_es.pdf
WHATSAPP_PDF_CAPTION=Aquí tiene el material de Euno. Quedo a su disposición para cualquier duda.
