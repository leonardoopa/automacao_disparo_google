# Copie para .env e preencha. O .env não vai para o git.

# Ponto central da busca (geocodificado pelo OpenStreetMap)
ORIGIN_ADDRESS=Rua Exemplo 1, Cidade
# Termos buscados no Maps, separados por vírgula
KEYWORDS=supermercado,mercado,tienda de alimentación
JOB_MAX_SECONDS=600

# WhatsApp Cloud API (Meta). Só preencha depois de ter número e template aprovados.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=troque-por-um-segredo
WHATSAPP_API_VERSION=v21.0
SEND_DELAY_S=1.5
